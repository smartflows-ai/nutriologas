// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── MULTITENANT ─────────────────────────────────────────
enum BusinessVertical {
  ECOMMERCE
  HEALTH
  VETERINARY
  TOURISM
  SERVICES
  PET_CARE
  TRAVEL
  GENERAL
}

model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  customDomain String? @unique
  logoUrl     String?
  whatsappNumber String?
  businessInfo   String?  // descripcion del negocio para la homepage
  ownerName           String? // Nombre del dueño o responsable del negocio
  hasPhysicalLocation Boolean @default(false) // El negocio tiene local fisico
  address             String? // Direccion formateada (Google Maps)
  placeId             String? // Google Place ID de la direccion
  latitude            Float?
  longitude           Float?
  isAssistantEnabled Boolean @default(true)
  isTriageEnabled    Boolean @default(false)
  vertical           BusinessVertical @default(ECOMMERCE) @map("businessVertical")
  isBookingEnabled   Boolean          @default(false)
  boardingCapacity   Int?             // Capacidad de hospedaje (veterinaria/hotel)
  aiCreditLimitUsd   Float?  // Override per-tenant AI credit cap (null = use plan default)
  botFailureAlertedAt DateTime? // Last time the owner was alerted that the WhatsApp bot's model cascade failed (throttles repeat alerts)
  remindersEnabled       Boolean @default(true)   // Recordatorios de cita por WhatsApp
  reminderOffsetsMinutes Int[]   @default([1440, 120]) // Legacy: ya no se usa (reemplazado por reminderMode)
  reminderLeadMinutes       Int     @default(1440) // Minutos antes de la cita en que sale el recordatorio (múltiplos de 30)
  reminderLeadHours         Int     @default(24) // Legacy: reemplazado por reminderLeadMinutes
  reminderMode              String  @default("DAY_BEFORE") // Legacy: reemplazado por reminderLeadHours
  reminderSendTime          String  @default("09:00") // Legacy: reemplazado por reminderLeadHours (HH:mm, hora de Mexico)
  confirmationRequired      Boolean @default(true)
  confirmationDeadlineMinutes Int   @default(120) // Minutos antes de la cita en que se libera si no confirma (múltiplos de 30)
  confirmationDeadlineHours Int     @default(2) // Legacy: reemplazado por confirmationDeadlineMinutes
  reminderTemplate          String?
  confirmationTemplate      String?
  cancellationTemplate      String?
  messageLanguage           String  @default("es") // Idioma de los mensajes al cliente: es | en
  businessHours          Json?   // Horario semanal de atención (null = horario por defecto, ver src/lib/business-hours.ts)
  appointmentNotes       AppointmentNote[]

  // Configuracion de colores (1:1)
  theme       ThemeConfig?

  // Relaciones
  users           User[]
  products        Product[]
  orders          Order[]
  appointments    Appointment[]
  reviews         Review[]
  carouselImages  CarouselImage[]
  connectedApps   ConnectedApp[]
  whatsappChats   WhatsAppChat[]
  whatsappMessages WhatsAppMessage[]
  faqs            FAQ[]
  socialCampaigns SocialCampaign[]
  socialPosts     SocialPost[]
  subscription    Subscription?
  patientProfiles PatientProfile[]
  pets            Pet[]
  aiTokenLedger   AiTokenLedger[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tenants")
}

model ThemeConfig {
  id             String  @id @default(uuid())
  tenantId       String  @unique
  tenant         Tenant  @relation(fields: [tenantId], references: [id])
  primaryColor   String  @default("#16a34a")
  secondaryColor String  @default("#15803d")
  accentColor    String  @default("#4ade80")
  fontFamily     String  @default("Inter")

  updatedAt DateTime @updatedAt

  @@map("theme_configs")
}

// ─── USUARIOS ────────────────────────────────────────────
enum UserRole {
  CUSTOMER
  ADMIN
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  email        String
  name         String?
  image        String?
  role         UserRole  @default(CUSTOMER)
  passwordHash String?
  googleId     String?
  conektaCustomerId String?
  orders  Order[]
  appointments Appointment[]
  reviews Review[]
  accounts Account[]
  sessions Session[]
  patientProfile PatientProfile?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@map("users")
}

// NextAuth tables
model Account {
  id                String  @id @default(uuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── APPS CONECTADAS (nivel tenant) ──────────────────────
enum AppProvider {
  GOOGLE
  MICROSOFT
  WHATSAPP
  FACEBOOK
}

model ConnectedApp {
  id                String      @id @default(uuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  provider          AppProvider
  accessToken       String
  refreshToken      String?
  tokenExpiry       DateTime?
  scopes            String?
  connectedAt       DateTime    @default(now())
  connectedByUserId String?

  // WhatsApp Evolution API specific fields
  waInstanceId    String?
  waInstanceName  String?
  waStatus        String?
  waQrCode        String?
  waPhoneNumber   String?
  waWebhookUrl    String?

  waTemperature   Float?      @default(0.7)
  waContext       String?     @db.Text

  metadata        Json?

  @@unique([tenantId, provider])
  @@map("connected_apps")
}

model WhatsAppChat {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  remoteJid   String   // e.g. 12345678@s.whatsapp.net
  pushName    String?
  lastMessage String?  @db.Text
  unreadCount Int      @default(0)
  botEnabled  Boolean  @default(true)  // false: the AI bot does not answer this contact
  botPausedReason String? // "manual" (owner switched it off) | "owner_reply" (owner wrote to the contact)
  updatedAt   DateTime @updatedAt

  messages    WhatsAppMessage[]

  @@unique([tenantId, remoteJid])
  @@map("whatsapp_chats")
}

model WhatsAppMessage {
  id        String   @id @default(uuid())
  chatId    String
  chat      WhatsAppChat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  remoteJid String
  keyId     String   @unique // ID del mensaje en WhatsApp para evitar duplicados
  content   String   @db.Text
  type      String   @default("text") // text, image, etc.
  fromMe    Boolean  @default(false)
  timestamp DateTime @default(now())

  @@index([tenantId])
  @@index([chatId])
  @@map("whatsapp_messages")
}

// ─── PACIENTES (Triage) ──────────────────────────────────
model PatientProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  remoteJid      String?  // WhatsApp identifier
  
  // Triage Data collected by AI
  age            Int?
  heightCm       Float?
  weightKg       Float?
  goals          String?  @db.Text
  allergies      String?  @db.Text
  medicalHistory String?  @db.Text
  medications    String?  @db.Text
  
  isTriageComplete Boolean @default(false)
  updatedAt      DateTime @updatedAt

  @@index([tenantId])
  @@map("patient_profiles")
}

// ─── PRODUCTOS Y SERVICIOS ───────────────────────────────
enum ItemType {
  PHYSICAL
  SERVICE
  PACKAGE
  SUBSCRIPTION
}

model Product {
  id              String    @id @default(uuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  name            String
  slug            String
  description     String?
  price           Float
  stock           Int       @default(0)
  isActive        Boolean   @default(true)
  images          String[]  // URLs de Cloudinary
  category        String?
  itemType        ItemType  @default(PHYSICAL)
  durationMinutes Int?      // duración para servicios (30, 60, etc.)
  requiresBooking Boolean   @default(false)
  capacity        Int?      // cupo máximo (null = sin límite)
  serviceConfig   Json?     // configuración específica por vertical

  orderItems      OrderItem[]
  appointments    Appointment[]
  reviews         Review[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete

  @@unique([tenantId, slug])
  @@map("products")
}

// ─── PEDIDOS ─────────────────────────────────────────────
enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD_CONEKTA
  OXXO_CONEKTA
  PAYPAL
}

model Order {
  id               String        @id @default(uuid())
  tenantId         String
  tenant           Tenant        @relation(fields: [tenantId], references: [id])
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  status           OrderStatus   @default(PENDING)
  total            Float
  paymentMethod    PaymentMethod?
  paymentReference String?       // Conekta order ID or PayPal reference
  conektaChargeId  String?       // Conekta charge ID (set by charge.created webhook)
  shippingAddress  Json?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  unitPrice Float

  @@map("order_items")
}

// ─── REVIEWS ─────────────────────────────────────────────
model Review {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  rating    Int     // 1-5
  comment   String?
  isVisible Boolean @default(true)

  createdAt DateTime @default(now())

  @@map("reviews")
}

// ─── CARRUSEL ────────────────────────────────────────────
model CarouselImage {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  url       String  // URL de Cloudinary
  alt       String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())

  @@map("carousel_images")
}

// ─── FAQS ───────────────────────────────────────────────
model FAQ {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id])
  question  String  @db.Text
  answer    String  @db.Text
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("faqs")
}

// ─── CAMPAÑAS SOCIALES ───────────────────────────────────
enum CampaignFrequency {
  DAILY
  EVERY_3_DAYS
  WEEKLY
  BIWEEKLY
  MONTHLY
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
}

model SocialCampaign {
  id              String             @id @default(uuid())
  tenantId        String
  tenant          Tenant             @relation(fields: [tenantId], references: [id])
  name            String             @default("Campaña")
  platforms       SocialPlatform[]   // [FACEBOOK, INSTAGRAM]
  productIds      String[]           // IDs of selected products
  selectedImageUrl String?          // Specific image URL chosen by the user from UI/catalog
  campaignGoal    String             // "promocion" | "informativo" | "urgencia" | "testimonio" | "educativo"
  tone            String             // "profesional" | "cercano" | "motivacional" | "urgente"
  extraContext    String?            @db.Text
  frequency       CampaignFrequency  @default(WEEKLY)
  isActive        Boolean            @default(true)
  pausedByCredits Boolean            @default(false) // true when auto-paused due to exhausted AI credits
  startDate       DateTime           @default(now())
  endDate         DateTime
  lastPostedAt    DateTime?
  nextPostAt      DateTime?          // computed on create/update
  
  // Tracking automation (n8n)
  lastResults     Json?              // Stores { facebook: { postId, success }, instagram: { ... } }
  lastError       String?            @db.Text
  lastErrorAt     DateTime?
  errorNode       String?            // The n8n node where the error occurred
  
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  posts           SocialPost[]

  @@map("social_campaigns")
}

model SocialPost {
  id              String         @id @default(uuid())
  tenantId        String
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  campaignId      String
  campaign        SocialCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  content         String         @db.Text   // The AI generated text
  platforms       String[]       // e.g. ["FACEBOOK", "INSTAGRAM"]
  frequency       String         // Inherited from the campaign at the time of posting
  
  postUrls        Json?          // { facebook: "url", instagram: "url" }
  postedAt        DateTime       @default(now())

  @@index([tenantId])
  @@index([campaignId])
  @@map("social_posts")
}

// ─── SUSCRIPCIONES (Stripe - Platform Billing) ──────────
enum PlanId {
  STARTER
  PRO
  CLINICA
  VETERINARY
  TOURISM
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
}

model Subscription {
  id                   String             @id @default(uuid())
  tenantId             String             @unique
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?

  plan                 PlanId             @default(STARTER)
  status               SubscriptionStatus @default(TRIALING)

  trialEndsAt          DateTime
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@map("subscriptions")
}

// ─── AI TOKEN LEDGER ─────────────────────────────────────────
// Tracks AI token spending per tenant per billing period
model AiTokenLedger {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])

  periodStart      DateTime // Start of the credit window (month boundary)
  periodEnd        DateTime // End of the credit window

  // Accumulated costs this period (USD) — retail billed against creditLimitUsd
  totalCostUsd        Float    @default(0)

  // Wholesale provider cost (actual COGS owed to OpenRouter)
  realProviderCostUsd Float    @default(0)

  // Net gross margin retained by platform (totalCostUsd - realProviderCostUsd)
  netMarginUsd        Float    @default(0)

  // Token count breakdown for display
  promptTokens        Int      @default(0)
  completionTokens    Int      @default(0)
  reminderCount       Int      @default(0)

  // Credit limit for this period (USD) — copied from plan at period creation
  creditLimitUsd      Float    @default(15.0)

  // State flags
  isPaused         Boolean  @default(false)
  pausedAt         DateTime?
  resumedAt        DateTime?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([tenantId, periodStart])
  @@map("ai_token_ledger")
}

// ─── CITAS Y RESERVAS ────────────────────────────────────
enum AppointmentStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Appointment {
  id              String            @id @default(uuid())
  tenantId        String
  tenant          Tenant            @relation(fields: [tenantId], references: [id])
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  productId       String
  product         Product           @relation(fields: [productId], references: [id])

  customerName    String?
  customerPhone   String?
  customerEmail   String?           // email que escribió el cliente al agendar
  patientKey      String?           // digits of customerPhone, normalized (src/lib/patient-key.ts); groups visits per patient
  externalProvider AppProvider?     // GOOGLE | MICROSOFT: calendario que replica esta cita
  externalEventId String?           // id del evento en ese calendario
  googleEventId   String?           // legacy: reemplazado por externalEventId tras el backfill
  remindersSent   Int[]             @default([]) // Legacy: ya no se usa
  reminderSentAt      DateTime?
  customerConfirmedAt DateTime?
  autoReleasedAt      DateTime?

  appointmentDate DateTime          // fecha y hora de la cita
  durationMinutes Int               // duración en minutos
  notes           String?           @db.Text
  internalNotes   String?           @db.Text

  status          AppointmentStatus @default(PENDING)
  orderId         String?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  notesHistory    AppointmentNote[]
  petId           String?
  pet             Pet?              @relation(fields: [petId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, appointmentDate])
  @@index([tenantId, patientKey])
  @@index([tenantId, petId])
  @@map("appointments")
}

// Clinical notes of a patient across visits. The patient is the normalized phone digits (see src/lib/patient-key.ts).
// One row per appointment: the doctor's note for that visit. Only the admin reads these.
// Pets of a veterinary (or pet care) tenant. The owner is the normalized phone key (patientKey), as for patients.
// nameKey is the lowercase trimmed name, so "Max" and " max " are one pet for the same owner.
model Pet {
  id           String        @id @default(uuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  patientKey   String
  name         String
  nameKey      String
  species      String?
  breed        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]

  @@unique([tenantId, patientKey, nameKey], map: "pets_tenantId_patientKey_nameKey_key")
  @@index([tenantId, patientKey])
  @@map("pets")
}

model AppointmentNote {
  id              String      @id @default(uuid())
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  patientKey      String
  appointmentId   String?
  appointment     Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  body            String      @db.Text
  authorName      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tenantId, patientKey])
  @@index([appointmentId])
  @@map("appointment_notes")
}
