# Base de datos - Supabase
# Pooler URL (port 6543) — used at runtime for connection pooling
DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-1-us-east-1.pooler.supabase.com:6543/postgres"
# Direct URL (port 5432) — required for `prisma db push` / migrate
# Same as DATABASE_URL but change 6543 → 5432
DIRECT_DATABASE_URL="postgresql://postgres.[PROJECT]:[PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="genera-uno-con: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (para login admins + Google Calendar)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Microsoft OAuth (para Outlook Calendar + Mail)
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# Conekta
CONEKTA_PRIVATE_KEY=""
NEXT_PUBLIC_CONEKTA_PUBLIC_KEY=""
CONEKTA_SUCCESS_URL="http://localhost:3000/checkout/success"
CONEKTA_FAILURE_URL="http://localhost:3000/checkout/error"

# PayPal
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""

# Anthropic (IA Chatbot)
ANTHROPIC_API_KEY=""

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Redis - Upstash (cache de sesiones)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Facebook OAuth (para publicar posts promocionales)
# Obtén estas credenciales en: https://developers.facebook.com → Tu App → Configuración → Básica
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# FACEBOOK_REDIRECT_URI se auto-detecta desde NEXTAUTH_URL si no se define
# FACEBOOK_REDIRECT_URI="http://localhost:3000/api/apps/oauth/facebook/callback"

# n8n: AI agent que genera y publica los posts de Facebook
# Si no se define, el post se publica directamente (sin generación de copy con IA)
N8N_FACEBOOK_WEBHOOK_URL=""

# Secreto para endpoints internos (usado por n8n al llamar /api/campaigns/social/due)
# Genera uno con: openssl rand -hex 32
INTERNAL_API_SECRET=""

# ─── Stripe (SaaS Platform Billing) ────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/test/apikeys (Test Mode)
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_REPLACE_ME"

# Price IDs — create these in Stripe Dashboard → Products
# (Test mode prices are prefixed with price_test_...)
STRIPE_PRICE_STARTER_MONTHLY="price_REPLACE_STARTER_MONTHLY"
STRIPE_PRICE_STARTER_ANNUAL="price_REPLACE_STARTER_ANNUAL"
STRIPE_PRICE_PRO_MONTHLY="price_REPLACE_PRO_MONTHLY"
STRIPE_PRICE_PRO_ANNUAL="price_REPLACE_PRO_ANNUAL"
